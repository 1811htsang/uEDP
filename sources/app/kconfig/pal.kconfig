menu "Log Dispatcher Configuration"
  config PAL_LOGDP_MAX_OUTPUT_FN
    int "Log output functions"
    default 8
    help
      Number of log output functions that can be registered.
endmenu

menu "Hardware Specifier"
  config PAL_NAME
    string "Hardware Name"
    default "uEDP"
    help
      Hardware name for identification. Code generation will be in lower case.
endmenu