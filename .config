
#
# Core Config
#

#
# Message Allocation Pool
#
CONFIG_CORE_UEDP_MSG_BLANK_QUEUE_SIZE=8
CONFIG_CORE_UEDP_MSG_ISR_QUEUE_SIZE=16
CONFIG_CORE_UEDP_MSG_ALLOC_QUEUE_SIZE=8
# CONFIG__UEDP_MSG_ALLOC_N_1 is not set
CONFIG__UEDP_MSG_ALLOC_N_2=y
# CONFIG__UEDP_MSG_ALLOC_N_4 is not set
# CONFIG__UEDP_MSG_ALLOC_N_8 is not set
# CONFIG__UEDP_MSG_ALLOC_N_16 is not set
# CONFIG__UEDP_MSG_ALLOC_N_32 is not set
CONFIG_CORE_UEDP_MSG_ALLOC_N_VALUE=2
CONFIG_CORE_UEDP_MSG_EXTAL_QUEUE_SIZE=8
# CONFIG__UEDP_MSG_EXTAL_N_1 is not set
CONFIG__UEDP_MSG_EXTAL_N_2=y
# CONFIG__UEDP_MSG_EXTAL_N_4 is not set
# CONFIG__UEDP_MSG_EXTAL_N_8 is not set
# CONFIG__UEDP_MSG_EXTAL_N_16 is not set
# CONFIG__UEDP_MSG_EXTAL_N_32 is not set
CONFIG_CORE_UEDP_MSG_EXTAL_N_VALUE=2
# end of Message Allocation Pool

#
# Task Message Queue
#
CONFIG_CORE_UEDP_TASK_MSG_QUEUE_SIZE=8
# end of Task Message Queue

#
# Timer Quantity
#
CONFIG_CORE_UEDP_TIMER_MAX_NODES=8
# end of Timer Quantity

#
# Internal Log Quantity
#
CONFIG_CORE_UEDP_ITNLOG_MAX_LOG_ENTRIES=32
CONFIG_CORE_UEDP_ITNLOG_FLUSH_THRESHOLD=28
# end of Internal Log Quantity
# end of Core Config

#
# PAL Config
#

#
# Log Dispatcher Configuration
#
CONFIG_PAL_LOGDP_MAX_OUTPUT_FN=8
# end of Log Dispatcher Configuration

#
# Hardware Specifier
#
CONFIG_PAL_NAME="hw"
# end of Hardware Specifier

#
# Hardware API configuration
#
# end of PAL Config

